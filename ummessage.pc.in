#ummessage pkg-config source file

prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: ummessage
Cflags: -I${includedir}
Libs: -L${libdir} -l:libummessage.@SHARED_LIBRARY_EXTENSION@.@MAJORVER@.@MINORVER@ 

Description: ummessage
Version: @VERSION@
Requires: ulib 


