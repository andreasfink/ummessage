CC=@CC@
CFLAGS=@CFLAGS@
CONFIGURATION=Release
LDFLAGS=@LDFLAGS@
MAJORVER=@MAJORVER@
MINORVER=@MINORVER@
REVISION=@REVISION@

LIB=lib@PROJECT_NAME@.@SHARED_LIBRARY_EXTENSION@
SLIB=lib@PROJECT_NAME@.a

PKGCONFIGFILE=@PROJECT_NAME@.pc

UMCLI_MFILES = $(wildcard umcli/*.m)
UMCLI_MOFILES  = $(UMCLI_MFILES:.m=.m.o)
UMCLI_OFILES  = $(UMCLI_MOFILES)

UMSERVER_MFILES = $(wildcard umserver/*.m)
UMSERVER_MOFILES  = $(UMSERVER_MFILES:.m=.m.o)
UMSERVER_OFILES  = $(UMSERVER_MOFILES)

UMDBSERVER_MFILES = $(wildcard umdbserver/*.m)
UMDBSERVER_MOFILES  = $(UMDBSERVER_MFILES:.m=.m.o)
UMDBSERVER_OFILES  = $(UMDBSERVER_MOFILES)

MFILES = $(wildcard ummessage/*.m)
HFILES = version.h $(wildcard ummessage/*.h)
MOFILES  = $(MFILES:.m=.m.o)
OFILES = $(MOFILES)

HEADERDIR=um

INCLUDEDIRS = -I .
DEBUG_RELEASE = -DCONFIGURATION_${CONFIGURATION}=1 -DCONFIGURATION=${CONFIGURATION}

all:	${LIB} build/umcli build/umserver build/umdbserver

${LIB}: ${OFILES}
	./make_version
	${CC} -shared -o ${LIB}  ${LDFLAGS} ${OFILES} ${LIBS} ${STATIC_LIBS}

${SLIB}: ${OFILES}
	ar rcs ${SLIB} ${OFILES}
	ranlib ${SLIB}
	
build/umcli: ${UMCLI_OFILES} ${LIB}
	-mkdir -p build/
	${CC} -o build/umcli  ${LDFLAGS} ${UMCLI_OFILES} ${LIB} ${LIBS} ${STATIC_LIBS}

build/umserver: ${UMSERVER_OFILES}  ${LIB}
	-mkdir -p build/
	${CC} -o build/umserver  ${LDFLAGS} ${UMSERVER_OFILES} ${LIB} ${LIBS} ${STATIC_LIBS}

build/umdbserver: ${UMDBSERVER_OFILES}  ${LIB}
	-mkdir -p build/
	${CC} -o build/umdbserver  ${LDFLAGS} ${UMDBSERVER_OFILES} ${LIB} ${LIBS} ${STATIC_LIBS}

install: ${LIB} ${SLIB} build/umcli build/umserver build/umdbserver
	-mkdir -p ${DESTDIR}/usr/local/lib/pkgconfig
	rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}.${REVISION}"
	rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}"
	rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}"
	rm -f "${DESTDIR}/usr/local/lib/${LIB}"
	install -b -g bin -o root -m 644 "${LIB}" "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}.${REVISION}"
	install -b -g bin -o root -m 644 "${SLIB}" "${DESTDIR}/usr/local/lib/${SLIB}"
	install -b -g bin -o root -m 755 build/umserver "${DESTDIR}/usr/local/bin/umserver"
	install -b -g bin -o root -m 755 build/umdbserver "${DESTDIR}/usr/local/bin/umdbserver"
	install -b -g bin -o root -m 755 build/umcli "${DESTDIR}/usr/local/bin/umcli"
	ln -s "${LIB}.${MAJORVER}.${MINORVER}.${REVISION}" "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}"
	ln -s "${LIB}.${MAJORVER}.${MINORVER}"             "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}"
	ln -s "${LIB}.${MAJORVER}"                         "${DESTDIR}/usr/local/lib/${LIB}"
	-install -b -g bin -o root -m 644 ${PKGCONFIGFILE} ${DESTDIR}/usr/local/lib/pkgconfig/
	-mkdir -p ${DESTDIR}/usr/local/include/${HEADERDIR}
	cp $(HFILES) ${DESTDIR}/usr/local/include/${HEADERDIR}
	ldconfig

clean:
	rm -f $(LIB) $(OFILES) $(SLIB)
	rm -rf build/

.SUFFIXES: .m.o .o .m .c

%.m.o:	%.m
	${CC} -c ${CFLAGS} ${DEBUG_RELEASE} -x objective-c -fobjc-arc $<  ${DEBUG_RELEASE} ${INCLUDEDIRS} -o $@


